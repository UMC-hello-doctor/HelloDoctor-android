<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============= Base Application Theme ============= -->
    <style name="Base.Theme.HelloDoctor" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Color system -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorTertiary">@color/color_info</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="android:colorForeground">@color/color_text_main</item>
    </style>

    <style name="Theme.HelloDoctor" parent="Base.Theme.HelloDoctor">
        <!-- Font and typography -->
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <!-- ============= Button Styles ============= -->
    <!-- Base button (match_parent width, medium height) -->
    <style name="Widget.HelloDoctor.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height_medium</item>
        <item name="android:layout_marginStart">@dimen/spacing_24</item>
        <item name="android:layout_marginEnd">@dimen/spacing_24</item>
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Label</item>
    </style>

    <!-- Primary button (blue background) -->
    <style name="Widget.HelloDoctor.Button.Primary" parent="Widget.HelloDoctor.Button">
        <item name="backgroundTint">@color/selector_button_primary_bg</item>
        <item name="android:textColor">@color/selector_button_primary_text</item>
    </style>

    <!-- Secondary button (white background, outlined) -->
    <style name="Widget.HelloDoctor.Button.Secondary" parent="Widget.HelloDoctor.Button">
        <item name="android:backgroundTint">@color/selector_button_secondary_bg</item>
        <item name="strokeColor">@color/selector_button_secondary_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/selector_button_secondary_text</item>
    </style>







    <!-- ============= Base Widget & Text Styles ============= -->
    <!-- Common widget base -->
    <style name="Widget.HelloDoctor" parent="@android:style/Widget" />

    <!-- Health record widget base -->
    <style name="Widget.HelloDoctor.Health" parent="Widget.HelloDoctor" />

    <!-- Common text appearance base -->
    <style name="TextAppearance.HelloDoctor" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/color_text_main</item>
    </style>

    <!-- Health record text base -->
    <style name="TextAppearance.HelloDoctor.Health" parent="TextAppearance.HelloDoctor" />

    <!-- ============= Health Record Card Styles ============= -->
    <!-- Health record card (filled) -->
    <style name="Widget.HelloDoctor.HealthCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">@dimen/corner_radius_large</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Card internal layout -->
    <style name="Widget.HelloDoctor.HealthCard.Content" parent="Widget.HelloDoctor.Health">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/spacing_16</item>
        <item name="android:paddingEnd">@dimen/spacing_16</item>
        <item name="android:paddingTop">@dimen/spacing_24</item>
        <item name="android:paddingBottom">@dimen/spacing_16</item>
    </style>

    <!-- Section header row (icon + text) -->
    <style name="Widget.HelloDoctor.Health.SectionHeaderRow" parent="Widget.HelloDoctor.Health">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">@dimen/spacing_16</item>
    </style>

    <!-- Label text appearance (name, gender, blood type, etc.) -->
    <style name="TextAppearance.HelloDoctor.Health.Label" parent="TextAppearance.HelloDoctor.Health">
        <item name="android:textColor">@color/color_text_sub</item>
        <item name="android:textAppearance">@style/TextAppearance.Caption</item>
    </style>

    <!-- Question text appearance -->
    <style name="TextAppearance.HelloDoctor.Health.Question" parent="TextAppearance.HelloDoctor.Health">
        <item name="android:textColor">@color/color_text_main</item>
        <item name="android:textAppearance">@style/TextAppearance.Body</item>
    </style>

    <!-- ============= Health Record TextInput Styles ============= -->
    <!-- Health record TextInputLayout (filled) -->
    <style name="Widget.HelloDoctor.Health.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/spacing_8</item>
        <item name="boxBackgroundColor">@color/color_button_secondary_bg</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_small</item>
    </style>

    <!-- Health record TextInputEditText -->
    <style name="Widget.HelloDoctor.Health.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.FilledBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/text_input_padding_vertical</item>
        <item name="android:textColor">@color/color_text_main</item>
        <item name="android:textColorHint">@color/color_text_hint</item>
    </style>

    <!-- ============= Health Record Choice Button Styles ============= -->
    <!-- Choice button base (yes/no, gender, blood type, etc.) -->
    <style name="Widget.HelloDoctor.Health.ChoiceButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/list_item_height_small</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:background">@null</item>
        <item name="cornerRadius">@dimen/corner_radius_small</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/selector_button_secondary_bg</item>
        <item name="strokeColor">@color/selector_button_secondary_stroke</item>
        <item name="android:textColor">@color/selector_button_secondary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Label</item>
    </style>

    <!-- Choice button for GridLayout (with columnWeight) -->
    <style name="Widget.HelloDoctor.Health.ChoiceButton.Grid" parent="Widget.HelloDoctor.Health.ChoiceButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill</item>
    </style>

    <!-- Choice button row container (yes/no, gender, etc.) -->
    <style name="Widget.HelloDoctor.Health.ChoiceRow" parent="Widget.HelloDoctor.Health">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginTop">@dimen/spacing_8</item>
    </style>
















</resources>