<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:orientation="vertical" >

            <include
                android:id="@+id/chatAi1"
                layout="@layout/view_chat_history_ai" />

            <include
                android:id="@+id/chatHuman1"
                layout="@layout/view_chat_history_human" />

            <include
                android:id="@+id/chatAi2"
                layout="@layout/view_chat_history_ai" />

            <include
                android:id="@+id/chatHuman2"
                layout="@layout/view_chat_history_human" />
        </LinearLayout>
    </ScrollView>
    <EditText
        android:id="@+id/memoEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/arrowButton"
        android:hint="내용을 입력하세요"
        android:inputType="textMultiLine"
        android:minLines="1"
        android:maxLines="6"
        android:gravity="top"
        android:scrollHorizontally="false" />



    <com.google.android.material.button.MaterialButton
        android:id="@+id/arrowButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:backgroundTint="@color/color_button_primary_bg"
        app:icon="@drawable/baseline_arrow_upward_24"
        style="@style/Widget.MaterialComponents.Button"
        />
</androidx.constraintlayout.widget.ConstraintLayout>