<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- 의료기관 검색 -->
    <ImageView
        android:id="@+id/menuHospital"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/menu_hospital"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 처방약 관리 -->
    <ImageView
        android:id="@+id/menuPrescription"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/menu_prescription"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 증상 번역 -->
    <ImageView
        android:id="@+id/menuSymptom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/menu_symptom"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="12dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuHospital"/>

    <!-- 마이페이지 -->
    <ImageView
        android:id="@+id/menuMyPage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/menu_mypage"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="12dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuPrescription"/>

</androidx.constraintlayout.widget.ConstraintLayout>



