<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeMenuFragment">

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.umc.hellodoctor.feature.chat.presentation.ChatFragment"
        android:label="ChatFragment"
        tools:layout="@layout/fragment_chat">
        <action
            android:id="@+id/action_chatFragment_to_chatResultFragment"
            app:destination="@id/chatResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatResultFragment"
        android:name="com.umc.hellodoctor.feature.chat.presentation.ChatResultFragment"
        android:label="ChatResultFragment"
        tools:layout="@layout/fragment_chat_result_container">
        <argument
            android:name="sessionId"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/homeMenuFragment"
        android:name="com.umc.hellodoctor.feature.basicFolder.presentation.HomeMenuFragment"
        android:label="HomeMenu"
        tools:layout="@layout/fragment_home_menu" >
        <action
            android:id="@+id/action_homeMenuFragment_to_symptomMenuFragment"
            app:destination="@id/symptomMenuFragment" />
        <action
            android:id="@+id/action_homeMenuFragment_to_drugSerchFragment"
            app:destination="@id/drugSerchFragment" />
        <action
            android:id="@+id/action_homeMenuFragment_to_drugAlarmFragment"
            app:destination="@id/drugAlarmFragment" />
        <action
            android:id="@+id/action_homeMenuFragment_to_myPageMenuFragment"
            app:destination="@id/myPageMenuFragment" />
    </fragment>

    <fragment
        android:id="@+id/languageSelectFragment"
        android:name="com.umc.hellodoctor.feature.language.presentation.LanguageSelectFragment"
        android:label="LanguageSelectFragment"
        tools:layout="@layout/fragment_language_select" />

    <fragment
        android:id="@+id/symptomMenuFragment"
        android:name="com.umc.hellodoctor.feature.menu.presentation.SymptomMenuFragment"
        android:label="SymptomMenu"
        tools:layout="@layout/fragment_symptom_menu" >
        <action
            android:id="@+id/action_symptomMenuFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_symptomMenuFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.umc.hellodoctor.feature.chat.presentation.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history">
        <action
            android:id="@+id/action_historyFragment_to_chatResultFragment"
            app:destination="@id/chatResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/userInfoFragment"
        android:name="com.umc.hellodoctor.feature.userinfo.UserInfoFragment"
        android:label="UserInfoFragment"
        tools:layout="@layout/fragment_user_info"/>
    <fragment
        android:id="@+id/drugSerchFragment"
        android:name="com.umc.hellodoctor.feature.drug.presentation.DrugSerchFragment"
        android:label="DrugSerchFragment"
        tools:layout="@layout/fragment_add_drug">
        <action
            android:id="@+id/action_drugSerchFragment_to_drugInfoInputFragment"
            app:destination="@id/drugInfoInputFragment" />
    </fragment>

    <fragment
        android:id="@+id/drugAlarmFragment"
        android:name="com.umc.hellodoctor.feature.drug.presentation.DrugAlarmFragment"
        android:label="DrugAlarmFragment"
        tools:layout="@layout/fragment_drug_alarm">
        <action
            android:id="@+id/action_drugAlarmFragment_to_drugSerchFragment"
            app:destination="@id/drugSerchFragment" />
        <action
            android:id="@+id/action_drugAlarmFragment_to_drugAlarmDetailFragment"
            app:destination="@id/drugAlarmDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/drugInfoInputFragment"
        android:name="com.umc.hellodoctor.feature.drug.presentation.DrugInfoInputFragment"
        android:label="DrugInfoInputFragment"
        tools:layout="@layout/fragment_drug_info_input">
        <argument
            android:name="medicines"
            app:argType="com.umc.hellodoctor.feature.drug.data.model.MedicineSearchItem[]" />
        <argument
            android:name="planId"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/drugAlarmDetailFragment"
        android:name="com.umc.hellodoctor.feature.drug.presentation.DrugAlarmDetailFragment"
        android:label="DrugAlarmDetailFragment"
        tools:layout="@layout/fragment_drug_alarm_detail">
        <argument
            android:name="planId"
            app:argType="string" />
        <action
            android:id="@+id/action_drugAlarmDetailFragment_to_drugAlarmFragment"
            app:destination="@id/drugAlarmFragment" />
        <action
            android:id="@+id/action_drugAlarmDetailFragment_to_drugInfoInputFragment"
            app:destination="@id/drugInfoInputFragment" />
    </fragment>

    <fragment
        android:id="@+id/myPageMenuFragment"
        android:name="com.umc.hellodoctor.feature.menu.presentation.MyPageMenuFragment"
        android:label="MyPageMenu"
        tools:layout="@layout/fragment_my_page_menu">
        <action
            android:id="@+id/action_myPageMenuFragment_to_languageSelectFragment"
            app:destination="@id/languageSelectFragment" />
    </fragment>

</navigation>