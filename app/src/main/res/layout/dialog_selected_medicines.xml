<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvSelectedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/selected_medicines"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvEmptySelectedMedicines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_selected_medicines"
        android:textSize="13sp"
        android:textColor="@color/gray_600"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSelectedMedicines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_selected_medicine" />

</LinearLayout>
