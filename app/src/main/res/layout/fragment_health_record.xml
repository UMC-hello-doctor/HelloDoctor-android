<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 기본정보 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="15.35dp"
                    android:paddingTop="21dp"
                    android:paddingEnd="15.35dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="건강 상태 기록표"
                        android:textColor="@color/color_text_main"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- 기본정보 섹션 타이틀 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/folder"
                            app:tint="@color/color_text_sub" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="기본정보"
                            android:textColor="@color/color_text_sub"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 이름 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="이름"
                        android:textColor="@color/color_text_sub" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxBackgroundColor="@color/color_button_health_bg"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeWidth="0dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="이름 입력"
                            android:padding="12dp"
                            android:textColor="@color/color_text_main"
                            android:textColorHint="#A0A0A0" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 성별 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="성별"
                        android:textColor="@color/color_text_sub" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFemale"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="여성"
                            android:textColor="@color/selector_button_health_text"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/selector_button_health_stroke"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMale"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="남성"
                            android:textColor="@color/selector_button_health_text"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/selector_button_health_stroke"
                            app:strokeWidth="1dp" />
                    </LinearLayout>

                    <!-- 생년월일 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="생년월일"
                        android:textColor="@color/color_text_sub" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBirth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxBackgroundColor="@color/color_button_health_bg"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeWidth="0dp"
                        app:endIconDrawable="@drawable/calendar"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBirth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="false"
                            android:padding="12dp"
                            android:textColor="@color/color_text_main"
                            android:textColorHint="#A0A0A0" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 혈액형 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="혈액형"
                        android:textColor="@color/color_text_sub" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:columnCount="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBloodA"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_columnWeight="1"
                            android:background="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="A형"
                            android:textColor="@color/selector_button_health_text"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/selector_button_health_stroke"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBloodB"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="B형"
                            android:textColor="@color/selector_button_health_text"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/selector_button_health_stroke"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBloodO"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="10dp"
                            android:background="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="O형"
                            android:textColor="@color/selector_button_health_text"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/selector_button_health_stroke"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBloodAB"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="10dp"
                            android:background="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="AB형"
                            android:textColor="@color/selector_button_health_text"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/selector_button_health_stroke"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBloodOther"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_columnSpan="2"
                            android:layout_marginTop="10dp"
                            android:background="@null"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="직접 입력하기"
                            android:textColor="@color/selector_button_health_text"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/selector_button_health_stroke"
                            app:strokeWidth="1dp" />
                    </GridLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilBloodOther"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        app:boxBackgroundColor="@color/color_button_health_bg"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeWidth="0dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBloodOther"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="혈액형 직접 입력"
                            android:padding="12dp"
                            android:textColor="@color/color_text_main"
                            android:textColorHint="#A0A0A0" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 건강 상태 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="21dp"
                    android:paddingEnd="15.35dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="15.35dp">

                    <!-- 건강 상태 섹션 타이틀 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/person"
                            app:tint="@color/color_text_sub" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="건강 상태"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_sub" />
                    </LinearLayout>

                    <!-- 1 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="1. 특정 약물이나 음식에 알레르기가 있나요?"
                        android:textColor="@color/color_text_main" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAllergyYes"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="네, 있어요"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:background="@null"
                            app:cornerRadius="12dp"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:strokeColor="@color/selector_button_health_stroke"
                            android:textColor="@color/selector_button_health_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAllergyNo"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="아니요, 없어요"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:background="@null"
                            app:cornerRadius="12dp"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:strokeColor="@color/selector_button_health_stroke"
                            android:textColor="@color/selector_button_health_text" />
                    </LinearLayout>

                    <!-- 1-1 (Yes일 때만 노출) -->
                    <LinearLayout
                        android:id="@+id/groupAllergyDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1-1. 어떤 알레르기를 가지고 있나요?"
                            android:textColor="@color/color_text_main" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="약물"
                            android:textColor="@color/color_text_sub" />

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:columnCount="2">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAllergyAntibiotic"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_columnWeight="1"
                                android:text="항생제"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:background="@null"
                                app:cornerRadius="12dp"
                                app:strokeWidth="1dp"
                                app:backgroundTint="@color/color_button_health_bg"
                                app:strokeColor="@color/selector_button_health_stroke"
                                android:textColor="@color/selector_button_health_text" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAllergyNsaid"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:layout_columnWeight="1"
                                android:text="소염진통제"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:background="@null"
                                app:cornerRadius="12dp"
                                app:strokeWidth="1dp"
                                app:backgroundTint="@color/color_button_health_bg"
                                app:strokeColor="@color/selector_button_health_stroke"
                                android:textColor="@color/selector_button_health_text" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAllergyVaccine"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="10dp"
                                android:layout_columnWeight="1"
                                android:text="백신 성분"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:background="@null"
                                app:cornerRadius="12dp"
                                app:strokeWidth="1dp"
                                app:backgroundTint="@color/color_button_health_bg"
                                app:strokeColor="@color/selector_button_health_stroke"
                                android:textColor="@color/selector_button_health_text" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAllergyLocal"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="10dp"
                                android:layout_columnWeight="1"
                                android:text="국소 마취제"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:background="@null"
                                app:cornerRadius="12dp"
                                app:strokeWidth="1dp"
                                app:backgroundTint="@color/color_button_health_bg"
                                app:strokeColor="@color/selector_button_health_stroke"
                                android:textColor="@color/selector_button_health_text" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAllergyOther"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginTop="10dp"
                                android:layout_columnSpan="2"
                                android:text="기타"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:background="@null"
                                app:cornerRadius="12dp"
                                app:strokeWidth="1dp"
                                app:backgroundTint="@color/color_button_health_bg"
                                app:strokeColor="@color/selector_button_health_stroke"
                                android:textColor="@color/selector_button_health_text" />
                        </GridLayout>
                    </LinearLayout>

                    <!-- 2 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="2. 현재 복용 중인 처방약이나 영양제가 있나요?"
                        android:textColor="@color/color_text_main" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMedsYes"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="네, 있어요"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:background="@null"
                            app:cornerRadius="12dp"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:strokeColor="@color/selector_button_health_stroke"
                            android:textColor="@color/selector_button_health_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMedsNo"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="아니요, 없어요"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:background="@null"
                            app:cornerRadius="12dp"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:strokeColor="@color/selector_button_health_stroke"
                            android:textColor="@color/selector_button_health_text" />
                    </LinearLayout>

                    <!-- 3 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="3. 현재 임신 중이거나 수유 중인가요?"
                        android:textColor="@color/color_text_main" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPregYes"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="네"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:background="@null"
                            app:cornerRadius="12dp"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:strokeColor="@color/selector_button_health_stroke"
                            android:textColor="@color/selector_button_health_text" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPregNo"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="아니요"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:background="@null"
                            app:cornerRadius="12dp"
                            app:strokeWidth="1dp"
                            app:backgroundTint="@color/color_button_health_bg"
                            app:strokeColor="@color/selector_button_health_stroke"
                            android:textColor="@color/selector_button_health_text" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 스크롤 여백 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="18dp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
