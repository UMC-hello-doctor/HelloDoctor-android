<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_auth"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.umc.hellodoctor.feature.auth.presentation.OnboardingFragment"
        android:label="OnboardingFragment"
        tools:layout="@layout/fragment_onboarding" />

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.umc.hellodoctor.feature.auth.presentation.WelcomeFragment"
        android:label="WelcomeFragment"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcomeFragment_to_userInfoFragment2"
            app:destination="@id/userInfoFragment2" />
    </fragment>
    <fragment
        android:id="@+id/userInfoFragment2"
        android:name="com.umc.hellodoctor.feature.userinfo.UserInfoFragment"
        android:label="UserInfoFragment"
        tools:layout="@layout/fragment_user_info"/>
</navigation>
