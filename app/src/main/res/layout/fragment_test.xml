<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnGoNetwork"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NetworkFragment 로 이동" />

    <Button
        android:id="@+id/btnGoNaverMap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NaverMapFragment 로 이동"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnGoCamera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CameraFragment 로 이동"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnGoNotification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NotificationFragment 로 이동"
        android:layout_marginTop="12dp" />

</LinearLayout>
