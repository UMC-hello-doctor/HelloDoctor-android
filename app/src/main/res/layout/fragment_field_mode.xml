<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="24dp">

    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_back_to_chat"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/white"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal|center_vertical"
                >

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_g_translate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="번역하기"
                    android:textSize="12sp"
                    android:paddingStart="6dp"
                    android:textColor="@color/color_text_main" />
            </LinearLayout>
        </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="환자 정보"
                android:textStyle="bold"
                android:textColor="@color/color_primary"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_text_main"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">

                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이름"
                        android:textColor="@color/color_text_main"
                        android:paddingEnd="8dp" />
                    <TextView
                        android:id="@+id/tv_patient_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bob"
                        android:textColor="@color/color_text_main" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="성별"
                        android:textColor="@color/color_text_main"
                        android:paddingEnd="8dp" />
                    <TextView
                        android:id="@+id/tv_patient_gender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="남자"
                        android:textColor="@color/color_text_main" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="생년월일"
                        android:textColor="@color/color_text_main"
                        android:paddingEnd="8dp" />
                    <TextView
                        android:id="@+id/tv_patient_birth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1998.03.03(yyyy.mm.dd)"
                        android:textColor="@color/color_text_main" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="혈액형"
                        android:textColor="@color/color_text_main"
                        android:paddingEnd="8dp" />
                    <TextView
                        android:id="@+id/tv_patient_blood_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="O형"
                        android:textColor="@color/color_text_main" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="복용약 유무"
                        android:textColor="@color/color_text_main"
                        android:paddingEnd="8dp" />
                    <TextView
                        android:id="@+id/tv_patient_medication"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="없음"
                        android:textColor="@color/color_text_main" />
                </TableRow>
            </TableLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_text_main"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="증상"
                    android:textStyle="bold"
                    android:textColor="@color/color_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_text_main"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <!-- 증상 항목 TableLayout (동적으로 채워짐) -->
            <TableLayout
                android:id="@+id/table_symptom_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">
            </TableLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_text_main"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사용언어"
                android:textStyle="bold"
                android:textColor="@color/color_primary"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_text_main"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/lang_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="영어"
                android:textColor="@color/color_text_main" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_back_to_chat"
        style="@style/Widget.HelloDoctor.Button.Secondary"
        android:text="헬로닥터 채팅으로 돌아가기"
        android:layout_height="50dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>