<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/historyItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chat session"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:textColor="@color/color_text_main" />

        <TextView
            android:id="@+id/historyPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Preview of last message goes here"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/color_text_sub"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/historyTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2026-02-11 10:30"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/color_text_sub" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

